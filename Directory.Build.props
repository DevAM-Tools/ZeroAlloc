<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- CIB only for explicit pack (dotnet pack -p:ContinuousIntegrationBuild=true) or CI pack jobs.
       Release test/coverage need local PDB paths — global CIB breaks MTP Cobertura. -->
  <PropertyGroup Condition="'$(CI)' == 'true' and '$(GeneratePackageOnBuild)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- XML docs only for shipped NuGet assemblies -->
  <PropertyGroup Condition="'$(IsPackable)' == 'false' or '$(IsTestProject)' == 'true' or '$(OutputType)' == 'Exe'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <VersionPrefix>0.6.2</VersionPrefix>
    <Authors>DevAM</Authors>
    <Company>DevAM</Company>
    <Copyright>Copyright © 2026 DevAM. All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/DevAM-Tools/ZeroAlloc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DevAM-Tools/ZeroAlloc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Id: CA1720. Why: public API methods intentionally mirror CLR type names (ZA.String, ZA.Utf8). Why global: every public String/Utf8/Bytes API; per-member SuppressMessage is not viable. User approved. -->
    <!-- Id: CA1304. Why: ZA.String defaults to InvariantCulture; string args are copied without culture. Why global: analyzer fires across the library surface; per-call pragma is not viable. User approved. -->
    <!-- Id: CA1707. Why: this repo's tests keep Method_Scenario_Expected. Why global: every test method; pragma per method is not viable. Conflicts with tech-tunit PascalCase-without-underscores — tech-tunit exception recorded (review E5 option B / implement 2026-10-10). User approved. -->
    <NoWarn>$(NoWarn);CA1720;CA1304;CA1707</NoWarn>
  </PropertyGroup>
</Project>
