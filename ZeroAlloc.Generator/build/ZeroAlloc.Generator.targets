<Project>
  <PropertyGroup>
    <ZeroAlloc_GenerateDefaultClass Condition="'$(ZeroAlloc_GenerateDefaultClass)' == ''">true</ZeroAlloc_GenerateDefaultClass>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ZeroAlloc_GenerateDefaultClass)' != 'true'">
    <DefineConstants>$(DefineConstants);ZEROALLOC_SUPPRESS_DEFAULT_ZA</DefineConstants>
  </PropertyGroup>
</Project>
